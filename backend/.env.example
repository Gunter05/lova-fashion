DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# Supabase — Project Settings → API
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_KEY=your-supabase-service-role-key   # Service role key (bypasses RLS) — used for Storage admin & DB REST calls
# SUPABASE_ANON_KEY=your-supabase-anon-key    # Anon key — only if frontend calls Supabase directly (not the case here)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret  # Project Settings → API → JWT Secret (not used in custom JWT flow)
ENV=development

# Auth / JWT (Module 1) — custom HS256 JWT, independent of Supabase Auth
# The backend is the sole auth authority; it connects to Supabase DB as postgres
# (superuser → RLS bypass). RLS policies protect against direct / external DB access.
JWT_SECRET=change-me-to-at-least-32-bytes-of-random-entropy
JWT_ISSUER=lova-fashion-auth
