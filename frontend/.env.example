# ──────────────────────────────────────────────────────────────────────────────
# Frontend environment variables (Vite)
#
# 1. Copy this file to .env.local for local development.
# 2. On Vercel, add each variable under Project → Settings → Environment Variables.
#
# All variables MUST start with VITE_ to be exposed to the browser bundle.
# ──────────────────────────────────────────────────────────────────────────────

# URL of the backend API (Render.com service)
# - Leave empty in local development: the Vite dev-server proxy handles routing.
# - Required in production: set to your Render backend URL (no trailing slash).
# Example: https://lova-fashion-api.onrender.com
VITE_API_URL=
